def subsidy(units, ration_card, elderly):

    if units <= 100:
        return "Full subsidy"

    elif 101 <= units <= 200:
        if ration_card:
            return "Partial subsidy"
        else:
            return "No subsidy"

    elif units > 200:
        if elderly:
            return "Special subsidy"
        else:
            return "No subsidy"


print(subsidy(100, True, False))
print(subsidy(101, True, False))
print(subsidy(200, True, False))
print(subsidy(201, True, False))